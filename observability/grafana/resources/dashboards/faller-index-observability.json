{
  "apiVersion": "dashboard.grafana.app/v1beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "faller-index-observability",
    "annotations": {
      "grafana.app/folder": "faller-index"
    }
  },
  "spec": {
    "annotations": {
      "list": []
    },
    "description": "Portfolio observability for the Faller / Index click shortener: link creation, redirects, latency, errors, and rate limiting. Metrics are process-local and intended to show the service's operational shape.",
    "graphTooltip": 1,
    "panels": [
      {
        "type": "text",
        "title": "Overview",
        "description": "A quick read on link creation, current process state, redirect volume, and redirect success.",
        "gridPos": {
          "h": 2,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "options": {
          "mode": "markdown",
          "content": "How much the shortener is being used, and whether redirect attempts are succeeding."
        },
        "transparent": true
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 0,
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 5,
          "w": 6,
          "x": 0,
          "y": 2
        },
        "id": 2,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
        "expr": "sum(shortener_links_created_total)",
            "legendFormat": "links created",
            "refId": "A"
          }
        ],
        "title": "Links created",
        "transparent": false,
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 0,
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 5,
          "w": 6,
          "x": 6,
          "y": 2
        },
        "id": 3,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "shortener_links_in_memory",
            "legendFormat": "active links",
            "refId": "A"
          }
        ],
        "title": "Active links in memory",
        "description": "Current link records held by this API process.",
        "transparent": false,
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 0,
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 5,
          "w": 6,
          "x": 12,
          "y": 2
        },
        "id": 4,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
        "expr": "sum(shortener_redirects_total)",
            "legendFormat": "redirect attempts",
            "refId": "A"
          }
        ],
        "title": "Total redirects",
      "description": "All redirect outcomes recorded by this API process.",
        "transparent": false,
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "fixedColor": "blue",
              "mode": "fixed"
            },
            "decimals": 1,
            "max": 100,
            "min": 0,
            "unit": "percent"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 5,
          "w": 6,
          "x": 18,
          "y": 2
        },
        "id": 5,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
        "expr": "100 * sum(shortener_redirects_total{outcome=\"success\"}) / clamp_min(sum(shortener_redirects_total), 1)",
            "legendFormat": "success",
            "refId": "A"
          }
        ],
        "title": "Redirect success",
        "description": "Successful redirect attempts as a percentage of all redirect outcomes.",
        "transparent": false,
        "type": "stat"
      },
      {
        "type": "text",
        "title": "User impact",
        "description": "Signals that describe what visitors experienced while resolving links.",
        "gridPos": {
          "h": 2,
          "w": 24,
          "x": 0,
          "y": 7
        },
        "id": 6,
        "options": {
          "mode": "markdown",
          "content": "Successful clicks, links that could not be resolved, and requests rejected by the limiter."
        },
        "transparent": true
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 0,
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 5,
          "w": 8,
          "x": 0,
          "y": 9
        },
        "id": 7,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
        "expr": "sum(shortener_redirects_total{outcome=\"success\"})",
            "legendFormat": "successful redirects",
            "refId": "A"
          }
        ],
        "title": "Successful redirects",
        "description": "Redirects where an active short link was found and a click event was recorded.",
        "transparent": false,
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 0,
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 5,
          "w": 8,
          "x": 8,
          "y": 9
        },
        "id": 8,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
        "expr": "sum(shortener_redirects_total{outcome=~\"not_found|inactive\"})",
            "legendFormat": "missing or inactive",
            "refId": "A"
          }
        ],
        "title": "Missing / inactive links",
        "description": "Redirect attempts for unknown, expired, or disabled links.",
        "transparent": false,
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 0,
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 5,
          "w": 8,
          "x": 16,
          "y": 9
        },
        "id": 9,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
        "expr": "shortener_rate_limited_total",
            "legendFormat": "rate-limited requests",
            "refId": "A"
          }
        ],
        "title": "Rate-limited requests",
        "description": "Requests rejected after exceeding the fixed-window limiter.",
        "transparent": false,
        "type": "stat"
      },
      {
        "type": "text",
        "title": "Performance",
        "description": "Request latency is calculated from the API's Prometheus histogram buckets.",
        "gridPos": {
          "h": 2,
          "w": 24,
          "x": 0,
          "y": 14
        },
        "id": 10,
        "options": {
          "mode": "markdown",
          "content": "Percentiles make the long tail visible alongside the typical request experience."
        },
        "transparent": true
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 3,
            "unit": "s"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 5,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "id": 11,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
            "legendFormat": "p50",
            "refId": "A"
          }
        ],
        "title": "API latency — p50",
        "description": "The median observed request duration across API routes.",
        "transparent": false,
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 3,
            "unit": "s"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 5,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "id": 12,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
            "legendFormat": "p95",
            "refId": "A"
          }
        ],
        "title": "API latency — p95",
        "description": "The slow-request tail across API routes.",
        "transparent": false,
        "type": "stat"
      },
      {
        "type": "text",
        "title": "Traffic",
        "description": "Time series for redirect outcomes and HTTP response status rates.",
        "gridPos": {
          "h": 2,
          "w": 24,
          "x": 0,
          "y": 21
        },
        "id": 13,
        "options": {
          "mode": "markdown",
          "content": "Outcome and status rates show whether traffic is healthy and where failures are occurring."
        },
        "transparent": true
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 12,
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "pointSize": 4,
              "showPoints": "never",
              "spanNulls": true
            },
            "unit": "reqps"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 9,
          "w": 12,
          "x": 0,
          "y": 23
        },
        "id": 14,
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "expr": "sum by (outcome) (rate(shortener_redirects_total[$__rate_interval]))",
            "legendFormat": "{{outcome}}",
            "refId": "A"
          }
        ],
        "title": "Redirect outcome rate",
        "description": "Redirect attempts by success, not-found, or inactive outcome.",
        "transparent": false,
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 12,
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "pointSize": 4,
              "showPoints": "never",
              "spanNulls": true
            },
            "unit": "reqps"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 9,
          "w": 12,
          "x": 12,
          "y": 23
        },
        "id": 15,
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "expr": "sum by (status) (rate(http_requests_total[$__rate_interval]))",
            "legendFormat": "HTTP {{status}}",
            "refId": "A"
          }
        ],
        "title": "HTTP response status rate",
        "description": "Request rate grouped by the bounded status label emitted by the API.",
        "transparent": false,
        "type": "timeseries"
      },
      {
        "type": "text",
        "title": "Storage note",
        "description": "Important deployment context for interpreting these metrics.",
        "gridPos": {
          "h": 7,
          "w": 24,
          "x": 0,
          "y": 32
        },
        "id": 16,
        "options": {
          "mode": "markdown",
          "content": "The shortener stores links, click events, and its redirect cache in the API process. That keeps this portfolio demo simple, but the data is **not durable**: Vercel cold starts or multiple serverless instances can reset or split the visible state. A production deployment would move the repository to PostgreSQL and the cache to Redis.\n\nThe counters and gauges shown here describe the Prometheus-visible process or scrape target, so resets are expected when a fresh instance starts."
        },
        "transparent": true
      }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "tags": [
      "faller-index",
      "click-shortener",
      "fastapi",
      "prometheus"
    ],
    "templating": {
      "list": [
        {
          "current": {
            "text": "Grafana Cloud Prometheus",
            "value": "grafanacloud-prom"
          },
          "hide": 0,
          "includeAll": false,
          "label": "Prometheus",
          "multi": false,
          "name": "DS_PROMETHEUS",
          "options": [],
          "query": "prometheus",
          "refresh": 1,
          "regex": "",
          "skipUrlSync": false,
          "type": "datasource"
        }
      ]
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h"
      ],
      "time_options": [
        "5m",
        "15m",
        "1h",
        "6h",
        "12h",
        "24h",
        "2d",
        "7d"
      ]
    },
    "title": "Faller / Index — Click Shortener"
  }
}
